#import "sqlite/SQLite"
#import "process"
#import "tally"
#import "byte_text_linux"
#import "c_string"
#import "number_text"
#import "text_buffer"

// Uku's local database on the desktop and Android: processes with their
// proposals and options, ballots, the sync account, and settings. Opening
// an older database upgrades it in place and keeps its data, except that a
// processes table from before process types existed is replaced, as the C
// client did.

STORAGE_SCHEMA :: "create table if not exists processes (id text primary key, type text not null, phase text not null, topic text not null, description text not null, proposal_minutes integer not null, voting_minutes integer not null, negative_weight integer not null, quorum_votes integer not null default 0, visibility text not null default 'public', proposal_visibility text not null default 'public', proposal_access text not null default 'public', voting_access text not null default 'public', local_address text not null, created_at integer not null, synced integer not null default 0); create table if not exists options (id text primary key, process_id text not null, label text not null, description text not null, position integer not null, foreign key(process_id) references processes(id)); create table if not exists proposals (id integer primary key autoincrement, process_id text not null, author_user_id text not null default '', remote_id text not null default '', display_name text not null default '', title text not null, description text not null, created_at integer not null, synced integer not null default 0, foreign key(process_id) references processes(id)); create table if not exists votes (process_id text not null, voter_user_id text not null, display_name text not null, reason text not null, scores text not null, updated_at integer not null, synced integer not null default 0, primary key(process_id, voter_user_id), foreign key(process_id) references processes(id)); create table if not exists results (process_id text primary key, result_json text not null, computed_at integer not null, foreign key(process_id) references processes(id)); create table if not exists account (id integer primary key check(id = 1), public_id text not null, public_key text not null, private_key text not null); create table if not exists settings (key text primary key, value text not null);"

StorageColumn :: struct {
    table: string
    column: string
    definition: string
}

database: *void;

StorageOpened :: () -> bool {
    return database != null
}

StorageClose :: () {
    if database != null {
        unused SqliteClose(database)
        database = null
    }
}

StorageTableExists :: (name: string) -> bool {
    statement: *void = null
    if SqlitePrepareText(database, "select 1 from sqlite_master where type='table' and name=?1", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, name, -1)
    exists := SqliteStep(statement) == SQLITE_ROW
    unused SqliteFinalize(statement)
    return exists
}

// Table names come from this file, never from data, so they are part of
// the statement.
StorageTableHasColumn :: (table: string, column: string) -> bool {
    sql: [128]u8
    if !CopyCString("pragma table_info(", sql[:]) {
        return false
    }
    length := StorageAppend(sql[:], 18, table)
    length = StorageAppend(sql[:], length, ")")
    if length < 0 {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, TextUntilNul(sql[:]), -1, *statement, null) != SQLITE_OK {
        return false
    }
    found := false
    while !found && SqliteStep(statement) == SQLITE_ROW {
        name := SqliteColumnText(statement, 1)
        if name != null && TextFromCString(name) == column {
            found = true
        }
    }
    unused SqliteFinalize(statement)
    return found
}

StorageAppend :: (output: []u8, length: s64, text: string) -> s64 {
    if length < 0 || length + text.count + 1 > output.count {
        return -1
    }
    index: s64 = 0
    while index < text.count {
        output[length + index] = text[index]
        index += 1
    }
    output[length + text.count] = cast(u8)0
    return length + text.count
}

// Processes from before process types cannot be read; the C client dropped
// them and their proposals, votes, options, and results.
StorageResetOldProcessSchema :: () {
    if !StorageTableExists("processes") || StorageTableHasColumn("processes", "type") {
        return
    }
    unused SqliteExecText(database, "drop table if exists processes")
    unused SqliteExecText(database, "drop table if exists proposals")
    unused SqliteExecText(database, "drop table if exists votes")
    unused SqliteExecText(database, "drop table if exists options")
    unused SqliteExecText(database, "drop table if exists results")
}

// Columns added after the first releases, as ALTER TABLE statements that
// older databases need.
StorageAddMissingColumns :: () {
    columns: [8]StorageColumn = .{
        StorageColumn.{"account", "auth_token", "alter table account add column auth_token text not null default ''"},
        StorageColumn.{"account", "server_url", "alter table account add column server_url text not null default 'https://api.waozi.xyz'"},
        StorageColumn.{"processes", "quorum_votes", "alter table processes add column quorum_votes integer not null default 0"},
        StorageColumn.{"processes", "owner_user_id", "alter table processes add column owner_user_id text not null default ''"},
        StorageColumn.{"processes", "proposal_visibility", "alter table processes add column proposal_visibility text not null default 'public'"},
        StorageColumn.{"processes", "proposal_access", "alter table processes add column proposal_access text not null default 'public'"},
        StorageColumn.{"processes", "voting_access", "alter table processes add column voting_access text not null default 'public'"},
        StorageColumn.{"proposals", "display_name", "alter table proposals add column display_name text not null default ''"}
    }
    index: s64 = 0
    while index < columns.count {
        if !StorageTableHasColumn(columns[index].table, columns[index].column) {
            unused SqliteExecText(database, columns[index].definition)
        }
        index += 1
    }
}

// Opens (or creates) the database at `path` and brings its schema up to
// date. Returns false, with nothing open, when it cannot.
StorageOpen :: (path: string) -> bool {
    StorageClose()
    bytes: [1024]u8
    if !CopyCString(path, bytes[:]) {
        return false
    }
    flags: s32 = SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE
    if SqliteOpen(*bytes[0], *database, flags) != SQLITE_OK {
        StorageClose()
        return false
    }
    StorageResetOldProcessSchema()
    if SqliteExecText(database, STORAGE_SCHEMA) != SQLITE_OK {
        StorageClose()
        return false
    }
    StorageAddMissingColumns()
    return true
}

// The setting's value, copied into output, or fallback when it is unset.
SettingLoadText :: (key: string, fallback: string, output: []u8) -> string {
    unused CopyCString(fallback, output)
    if database == null {
        return TextUntilNul(output)
    }
    statement: *void = null
    if SqlitePrepareText(database, "select value from settings where key=?", -1, *statement, null) != SQLITE_OK {
        return TextUntilNul(output)
    }
    unused SqliteBindTextString(statement, 1, key, -1)
    if SqliteStep(statement) == SQLITE_ROW {
        value := SqliteColumnText(statement, 0)
        if value != null {
            unused CopyCString(TextFromCString(value), output)
        }
    }
    unused SqliteFinalize(statement)
    return TextUntilNul(output)
}

SettingSaveText :: (key: string, value: string) -> bool {
    if database == null {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, "insert or replace into settings(key, value) values(?, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, key, -1)
    unused SqliteBindTextString(statement, 2, value, -1)
    saved := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return saved
}

// Reads a whole number the way the C client's atoi did: an optional sign,
// then digits; anything else ends it, and no digits read as 0.
StorageReadInt :: (text: string) -> s32 {
    index: s64 = 0
    negative := false
    if index < text.count && (text[index] == cast(u8)45 || text[index] == cast(u8)43) {
        negative = text[index] == cast(u8)45
        index += 1
    }
    value: s64 = 0
    while index < text.count && text[index] >= cast(u8)48 && text[index] <= cast(u8)57 {
        if value < 2147483648 {
            value = value * 10 + cast(s64)(text[index] - cast(u8)48)
        }
        index += 1
    }
    if negative {
        value = -value
    }
    if value > 2147483647 {
        return 2147483647
    }
    if value < -2147483648 {
        return -2147483648
    }
    return cast(s32)value
}

SettingLoadInt :: (key: string, fallback: s32) -> s32 {
    fallback_text: [24]u8
    value: [32]u8
    text := SettingLoadText(key, FormatInteger(cast(s64)fallback, fallback_text[:]), value[:])
    return StorageReadInt(text)
}

SettingSaveInt :: (key: string, value: s32) -> bool {
    text: [24]u8
    return SettingSaveText(key, FormatInteger(cast(s64)value, text[:]))
}

MAX_PROCESSES :: 128

// A process as the dashboard lists it.
ProcessRow :: struct {
    id: [40]u8
    local_address: [512]u8
    owner: [65]u8
    topic: [180]u8
    description: [420]u8
    type: ProcessType
    proposal_minutes: s32
    voting_minutes: s32
    negative_weight: s32
    quorum_votes: s32
    visibility: [16]u8
    proposal_visibility: [16]u8
    proposal_access: [16]u8
    voting_access: [16]u8
    created_at: s64
}

process_rows: [MAX_PROCESSES]ProcessRow;
process_row_count: s32;

// Copies a text column into output, or fallback when it is NULL or empty.
StorageColumnText :: (statement: *void, column: s32, fallback: string, output: []u8) {
    value := SqliteColumnText(statement, column)
    if value == null || value[0] == cast(u8)0 {
        unused CopyCString(fallback, output)
        return
    }
    unused CopyCString(TextFromCString(value), output)
}

// Loads the newest processes, up to MAX_PROCESSES, into process_rows.
StorageLoadProcesses :: () -> s32 {
    process_row_count = 0
    if database == null {
        return 0
    }
    statement: *void = null
    if SqlitePrepareText(database, "select id, type, topic, description, proposal_minutes, voting_minutes, negative_weight, visibility, local_address, created_at, quorum_votes, owner_user_id, proposal_visibility, proposal_access, voting_access from processes order by created_at desc limit ?", -1, *statement, null) != SQLITE_OK {
        return 0
    }
    unused SqliteBindInt(statement, 1, MAX_PROCESSES)
    while process_row_count < MAX_PROCESSES && SqliteStep(statement) == SQLITE_ROW {
        row: ProcessRow
        type_key: [40]u8
        StorageColumnText(statement, 0, "", row.id[:])
        StorageColumnText(statement, 1, "consent", type_key[:])
        row.type = ProcessTypeFromKey(TextUntilNul(type_key[:]))
        StorageColumnText(statement, 2, "", row.topic[:])
        StorageColumnText(statement, 3, "", row.description[:])
        row.proposal_minutes = SqliteColumnInt(statement, 4)
        row.voting_minutes = SqliteColumnInt(statement, 5)
        row.negative_weight = SqliteColumnInt(statement, 6)
        if ProcessUsesNegativeWeight(row.type) {
            row.negative_weight = NegativeWeightNormalize(row.negative_weight)
        }
        StorageColumnText(statement, 7, "public", row.visibility[:])
        StorageColumnText(statement, 8, "", row.local_address[:])
        row.created_at = SqliteColumnInt64(statement, 9)
        row.quorum_votes = SqliteColumnInt(statement, 10)
        StorageColumnText(statement, 11, "", row.owner[:])
        StorageColumnText(statement, 12, "public", row.proposal_visibility[:])
        StorageColumnText(statement, 13, "public", row.proposal_access[:])
        StorageColumnText(statement, 14, "public", row.voting_access[:])
        process_rows[process_row_count] = row
        process_row_count += 1
    }
    unused SqliteFinalize(statement)
    return process_row_count
}

// Inserts a proposal and returns its local rowid, or -1.
StorageInsertProposal :: (process_id: string, author: string, display_name: string, title: string, description: string, created_at: s64, synced: bool) -> s64 {
    statement: *void = null
    if SqlitePrepareText(database, "insert into proposals(process_id, author_user_id, display_name, title, description, created_at, synced) values(?, ?, ?, ?, ?, ?, ?)", -1, *statement, null) != SQLITE_OK {
        return -1
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    unused SqliteBindTextString(statement, 2, author, -1)
    unused SqliteBindTextString(statement, 3, display_name, -1)
    unused SqliteBindTextString(statement, 4, title, -1)
    unused SqliteBindTextString(statement, 5, description, -1)
    unused SqliteBindInt64(statement, 6, created_at)
    unused SqliteBindInt(statement, 7, ifx synced then 1 else 0)
    inserted := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    if !inserted {
        return -1
    }
    return SqliteLastInsertRowid(database)
}

StorageHasText :: (text: string) -> bool {
    index: s64 = 0
    while index < text.count {
        byte := text[index]
        if byte != cast(u8)32 && byte != cast(u8)9 && byte != cast(u8)10 && byte != cast(u8)13 {
            return true
        }
        index += 1
    }
    return false
}

// Inserts a ranked-process option; an option without a label is skipped.
StorageInsertOption :: (process_id: string, option: Option, position: s32) -> bool {
    if !StorageHasText(TextUntilNul(option.label[:])) {
        return true
    }
    statement: *void = null
    if SqlitePrepareText(database, "insert into options(id, process_id, label, description, position) values(?, ?, ?, ?, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, TextUntilNul(option.id[:]), -1)
    unused SqliteBindTextString(statement, 2, process_id, -1)
    unused SqliteBindTextString(statement, 3, TextUntilNul(option.label[:]), -1)
    unused SqliteBindTextString(statement, 4, TextUntilNul(option.description[:]), -1)
    unused SqliteBindInt(statement, 5, position)
    inserted := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return inserted
}

// The standing proposals of a new consent process that has none of its own.
StandingProposals :: struct {
    status_quo_title: string
    status_quo_description: string
    repeat_title: string
    repeat_description: string
}

StorageInsertProcessRow :: (row: ProcessRow) -> bool {
    statement: *void = null
    if SqlitePrepareText(database, "insert into processes(id, type, phase, topic, description, proposal_minutes, voting_minutes, negative_weight, quorum_votes, visibility, proposal_visibility, proposal_access, voting_access, local_address, created_at, synced, owner_user_id) values(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, TextUntilNul(row.id[:]), -1)
    unused SqliteBindTextString(statement, 2, ProcessTypeKey(row.type), -1)
    unused SqliteBindTextString(statement, 3, "published", -1)
    unused SqliteBindTextString(statement, 4, TextUntilNul(row.topic[:]), -1)
    unused SqliteBindTextString(statement, 5, TextUntilNul(row.description[:]), -1)
    unused SqliteBindInt(statement, 6, row.proposal_minutes)
    unused SqliteBindInt(statement, 7, row.voting_minutes)
    unused SqliteBindInt(statement, 8, row.negative_weight)
    unused SqliteBindInt(statement, 9, row.quorum_votes)
    unused SqliteBindTextString(statement, 10, TextUntilNul(row.visibility[:]), -1)
    unused SqliteBindTextString(statement, 11, TextUntilNul(row.proposal_visibility[:]), -1)
    unused SqliteBindTextString(statement, 12, TextUntilNul(row.proposal_access[:]), -1)
    unused SqliteBindTextString(statement, 13, TextUntilNul(row.voting_access[:]), -1)
    unused SqliteBindTextString(statement, 14, TextUntilNul(row.local_address[:]), -1)
    unused SqliteBindInt64(statement, 15, row.created_at)
    unused SqliteBindTextString(statement, 16, TextUntilNul(row.owner[:]), -1)
    inserted := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return inserted
}

// Saves a newly created process in one transaction: the process, then its
// options (ranked) or proposals (consent), all as the owner's. A consent
// process without proposals starts with the two standing ones.
StorageSaveNewProcess :: (row: ProcessRow, owner_name: string, standing: StandingProposals) -> bool {
    if database == null || SqliteExecText(database, "begin immediate") != SQLITE_OK {
        return false
    }
    process_id := TextUntilNul(row.id[:])
    owner := TextUntilNul(row.owner[:])
    saved := StorageInsertProcessRow(row)
    if saved && ProcessHasOptions(row.type) {
        index: s32 = 0
        while saved && index < process.option_count {
            saved = StorageInsertOption(process_id, process.options[index], index)
            index += 1
        }
    }
    if saved && row.type == ProcessType.ProcessConsent {
        if process.proposal_count > 0 {
            index: s32 = 0
            while saved && index < process.proposal_count {
                proposal := process.proposals[index]
                saved = StorageInsertProposal(process_id, owner, owner_name, TextUntilNul(proposal.title[:]), TextUntilNul(proposal.description[:]), row.created_at, true) >= 0
                index += 1
            }
        } else {
            saved = StorageInsertProposal(process_id, owner, "", standing.status_quo_title, standing.status_quo_description, row.created_at, true) >= 0
            if saved {
                saved = StorageInsertProposal(process_id, owner, "", standing.repeat_title, standing.repeat_description, row.created_at, true) >= 0
            }
        }
    }
    if saved {
        saved = SqliteExecText(database, "commit") == SQLITE_OK
    }
    if !saved {
        unused SqliteExecText(database, "rollback")
    }
    return saved
}
