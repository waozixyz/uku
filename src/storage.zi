#import "sqlite/SQLite"
#import "daochi_client/keys"
#import "ballot"
#import "process"
#import "tally"
#import "byte_text_linux"
#import "c_string"
#import "number_text"
#import "text_buffer"
#import "text_append"

// Uku's local database on the desktop and Android: processes with their
// proposals and options, ballots, the sync account, and settings. Opening
// an older database upgrades it in place and keeps its data, except that a
// processes table from before process types existed is replaced, as the C
// client did.

STORAGE_SCHEMA :: "create table if not exists processes (id text primary key, type text not null, phase text not null, topic text not null, description text not null, proposal_minutes integer not null, voting_minutes integer not null, negative_weight integer not null, quorum_votes integer not null default 0, visibility text not null default 'public', proposal_visibility text not null default 'public', proposal_access text not null default 'public', voting_access text not null default 'public', local_address text not null, created_at integer not null, synced integer not null default 0); create table if not exists options (id text primary key, process_id text not null, label text not null, description text not null, position integer not null, foreign key(process_id) references processes(id)); create table if not exists proposals (id integer primary key autoincrement, process_id text not null, author_user_id text not null default '', remote_id text not null default '', display_name text not null default '', title text not null, description text not null, created_at integer not null, synced integer not null default 0, foreign key(process_id) references processes(id)); create table if not exists votes (process_id text not null, voter_user_id text not null, display_name text not null, reason text not null, scores text not null, updated_at integer not null, synced integer not null default 0, primary key(process_id, voter_user_id), foreign key(process_id) references processes(id)); create table if not exists results (process_id text primary key, result_json text not null, computed_at integer not null, foreign key(process_id) references processes(id)); create table if not exists account (id integer primary key check(id = 1), public_id text not null, public_key text not null, private_key text not null); create table if not exists settings (key text primary key, value text not null);"

StorageColumn :: struct {
    table: string
    column: string
    definition: string
}

database: *void;

StorageOpened :: () -> bool {
    return database != null
}

StorageClose :: () {
    if database != null {
        unused SqliteClose(database)
        database = null
    }
}

StorageTableExists :: (name: string) -> bool {
    statement: *void = null
    if SqlitePrepareText(database, "select 1 from sqlite_master where type='table' and name=?1", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, name, -1)
    exists := SqliteStep(statement) == SQLITE_ROW
    unused SqliteFinalize(statement)
    return exists
}

// Table names come from this file, never from data, so they are part of
// the statement.
StorageTableHasColumn :: (table: string, column: string) -> bool {
    sql: [128]u8
    if !CopyCString("pragma table_info(", sql[:]) {
        return false
    }
    length := TextAppend(sql[:], 18, table)
    length = TextAppend(sql[:], length, ")")
    if length < 0 {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, TextUntilNul(sql[:]), -1, *statement, null) != SQLITE_OK {
        return false
    }
    found := false
    while !found && SqliteStep(statement) == SQLITE_ROW {
        name := SqliteColumnText(statement, 1)
        if name != null && TextFromCString(name) == column {
            found = true
        }
    }
    unused SqliteFinalize(statement)
    return found
}

// Processes from before process types cannot be read; the C client dropped
// them and their proposals, votes, options, and results.
StorageResetOldProcessSchema :: () {
    if !StorageTableExists("processes") || StorageTableHasColumn("processes", "type") {
        return
    }
    unused SqliteExecText(database, "drop table if exists processes")
    unused SqliteExecText(database, "drop table if exists proposals")
    unused SqliteExecText(database, "drop table if exists votes")
    unused SqliteExecText(database, "drop table if exists options")
    unused SqliteExecText(database, "drop table if exists results")
}

// Columns added after the first releases, as ALTER TABLE statements that
// older databases need.
StorageAddMissingColumns :: () {
    columns: [8]StorageColumn = .{
        StorageColumn.{"account", "auth_token", "alter table account add column auth_token text not null default ''"},
        StorageColumn.{"account", "server_url", "alter table account add column server_url text not null default 'https://api.waozi.xyz'"},
        StorageColumn.{"processes", "quorum_votes", "alter table processes add column quorum_votes integer not null default 0"},
        StorageColumn.{"processes", "owner_user_id", "alter table processes add column owner_user_id text not null default ''"},
        StorageColumn.{"processes", "proposal_visibility", "alter table processes add column proposal_visibility text not null default 'public'"},
        StorageColumn.{"processes", "proposal_access", "alter table processes add column proposal_access text not null default 'public'"},
        StorageColumn.{"processes", "voting_access", "alter table processes add column voting_access text not null default 'public'"},
        StorageColumn.{"proposals", "display_name", "alter table proposals add column display_name text not null default ''"}
    }
    index: s64 = 0
    while index < columns.count {
        if !StorageTableHasColumn(columns[index].table, columns[index].column) {
            unused SqliteExecText(database, columns[index].definition)
        }
        index += 1
    }
}

// Opens (or creates) the database at `path` and brings its schema up to
// date. Returns false, with nothing open, when it cannot.
StorageOpen :: (path: string) -> bool {
    StorageClose()
    bytes: [1024]u8
    if !CopyCString(path, bytes[:]) {
        return false
    }
    flags: s32 = SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE
    if SqliteOpen(*bytes[0], *database, flags) != SQLITE_OK {
        StorageClose()
        return false
    }
    StorageResetOldProcessSchema()
    if SqliteExecText(database, STORAGE_SCHEMA) != SQLITE_OK {
        StorageClose()
        return false
    }
    StorageAddMissingColumns()
    return true
}

// The setting's value, copied into output, or fallback when it is unset.
SettingLoadText :: (key: string, fallback: string, output: []u8) -> string {
    unused CopyCString(fallback, output)
    if database == null {
        return TextUntilNul(output)
    }
    statement: *void = null
    if SqlitePrepareText(database, "select value from settings where key=?", -1, *statement, null) != SQLITE_OK {
        return TextUntilNul(output)
    }
    unused SqliteBindTextString(statement, 1, key, -1)
    if SqliteStep(statement) == SQLITE_ROW {
        value := SqliteColumnText(statement, 0)
        if value != null {
            unused CopyCString(TextFromCString(value), output)
        }
    }
    unused SqliteFinalize(statement)
    return TextUntilNul(output)
}

SettingSaveText :: (key: string, value: string) -> bool {
    if database == null {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, "insert or replace into settings(key, value) values(?, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, key, -1)
    unused SqliteBindTextString(statement, 2, value, -1)
    saved := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return saved
}

// Reads a whole number the way the C client's atoi did: an optional sign,
// then digits; anything else ends it, and no digits read as 0.
StorageReadInt :: (text: string) -> s32 {
    index: s64 = 0
    negative := false
    if index < text.count && (text[index] == cast(u8)45 || text[index] == cast(u8)43) {
        negative = text[index] == cast(u8)45
        index += 1
    }
    value: s64 = 0
    while index < text.count && text[index] >= cast(u8)48 && text[index] <= cast(u8)57 {
        if value < 2147483648 {
            value = value * 10 + cast(s64)(text[index] - cast(u8)48)
        }
        index += 1
    }
    if negative {
        value = -value
    }
    if value > 2147483647 {
        return 2147483647
    }
    if value < -2147483648 {
        return -2147483648
    }
    return cast(s32)value
}

SettingLoadInt :: (key: string, fallback: s32) -> s32 {
    fallback_text: [24]u8
    value: [32]u8
    text := SettingLoadText(key, FormatInteger(cast(s64)fallback, fallback_text[:]), value[:])
    return StorageReadInt(text)
}

SettingSaveInt :: (key: string, value: s32) -> bool {
    text: [24]u8
    return SettingSaveText(key, FormatInteger(cast(s64)value, text[:]))
}

MAX_PROCESSES :: 128

// A process as the dashboard lists it.
ProcessRow :: struct {
    id: [40]u8
    local_address: [512]u8
    owner: [65]u8
    topic: [180]u8
    description: [420]u8
    type: ProcessType
    proposal_minutes: s32
    voting_minutes: s32
    negative_weight: s32
    quorum_votes: s32
    visibility: [16]u8
    proposal_visibility: [16]u8
    proposal_access: [16]u8
    voting_access: [16]u8
    created_at: s64
}

process_rows: [MAX_PROCESSES]ProcessRow;
process_row_count: s32;

// Copies a text column into output, or fallback when it is NULL or empty.
StorageColumnText :: (statement: *void, column: s32, fallback: string, output: []u8) {
    value := SqliteColumnText(statement, column)
    if value == null || value[0] == cast(u8)0 {
        unused CopyCString(fallback, output)
        return
    }
    unused CopyCString(TextFromCString(value), output)
}

// Loads the newest processes, up to MAX_PROCESSES, into process_rows.
StorageLoadProcesses :: () -> s32 {
    process_row_count = 0
    if database == null {
        return 0
    }
    statement: *void = null
    if SqlitePrepareText(database, "select id, type, topic, description, proposal_minutes, voting_minutes, negative_weight, visibility, local_address, created_at, quorum_votes, owner_user_id, proposal_visibility, proposal_access, voting_access from processes order by created_at desc limit ?", -1, *statement, null) != SQLITE_OK {
        return 0
    }
    unused SqliteBindInt(statement, 1, MAX_PROCESSES)
    while process_row_count < MAX_PROCESSES && SqliteStep(statement) == SQLITE_ROW {
        row: ProcessRow
        type_key: [40]u8
        StorageColumnText(statement, 0, "", row.id[:])
        StorageColumnText(statement, 1, "consent", type_key[:])
        row.type = ProcessTypeFromKey(TextUntilNul(type_key[:]))
        StorageColumnText(statement, 2, "", row.topic[:])
        StorageColumnText(statement, 3, "", row.description[:])
        row.proposal_minutes = SqliteColumnInt(statement, 4)
        row.voting_minutes = SqliteColumnInt(statement, 5)
        row.negative_weight = SqliteColumnInt(statement, 6)
        if ProcessUsesNegativeWeight(row.type) {
            row.negative_weight = NegativeWeightNormalize(row.negative_weight)
        }
        StorageColumnText(statement, 7, "public", row.visibility[:])
        StorageColumnText(statement, 8, "", row.local_address[:])
        row.created_at = SqliteColumnInt64(statement, 9)
        row.quorum_votes = SqliteColumnInt(statement, 10)
        StorageColumnText(statement, 11, "", row.owner[:])
        StorageColumnText(statement, 12, "public", row.proposal_visibility[:])
        StorageColumnText(statement, 13, "public", row.proposal_access[:])
        StorageColumnText(statement, 14, "public", row.voting_access[:])
        process_rows[process_row_count] = row
        process_row_count += 1
    }
    unused SqliteFinalize(statement)
    return process_row_count
}

// Inserts a proposal and returns its local rowid, or -1.
StorageInsertProposal :: (process_id: string, author: string, display_name: string, title: string, description: string, created_at: s64, synced: bool) -> s64 {
    statement: *void = null
    if SqlitePrepareText(database, "insert into proposals(process_id, author_user_id, display_name, title, description, created_at, synced) values(?, ?, ?, ?, ?, ?, ?)", -1, *statement, null) != SQLITE_OK {
        return -1
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    unused SqliteBindTextString(statement, 2, author, -1)
    unused SqliteBindTextString(statement, 3, display_name, -1)
    unused SqliteBindTextString(statement, 4, title, -1)
    unused SqliteBindTextString(statement, 5, description, -1)
    unused SqliteBindInt64(statement, 6, created_at)
    unused SqliteBindInt(statement, 7, ifx synced then 1 else 0)
    inserted := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    if !inserted {
        return -1
    }
    return SqliteLastInsertRowid(database)
}

StorageHasText :: (text: string) -> bool {
    index: s64 = 0
    while index < text.count {
        byte := text[index]
        if byte != cast(u8)32 && byte != cast(u8)9 && byte != cast(u8)10 && byte != cast(u8)13 {
            return true
        }
        index += 1
    }
    return false
}

// Inserts a ranked-process option; an option without a label is skipped.
StorageInsertOption :: (process_id: string, option: Option, position: s32) -> bool {
    if !StorageHasText(TextUntilNul(option.label[:])) {
        return true
    }
    statement: *void = null
    if SqlitePrepareText(database, "insert into options(id, process_id, label, description, position) values(?, ?, ?, ?, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, TextUntilNul(option.id[:]), -1)
    unused SqliteBindTextString(statement, 2, process_id, -1)
    unused SqliteBindTextString(statement, 3, TextUntilNul(option.label[:]), -1)
    unused SqliteBindTextString(statement, 4, TextUntilNul(option.description[:]), -1)
    unused SqliteBindInt(statement, 5, position)
    inserted := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return inserted
}

// The standing proposals of a new consent process that has none of its own.
StandingProposals :: struct {
    status_quo_title: string
    status_quo_description: string
    repeat_title: string
    repeat_description: string
}

StorageInsertProcessRow :: (row: ProcessRow) -> bool {
    statement: *void = null
    if SqlitePrepareText(database, "insert into processes(id, type, phase, topic, description, proposal_minutes, voting_minutes, negative_weight, quorum_votes, visibility, proposal_visibility, proposal_access, voting_access, local_address, created_at, synced, owner_user_id) values(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, TextUntilNul(row.id[:]), -1)
    unused SqliteBindTextString(statement, 2, ProcessTypeKey(row.type), -1)
    unused SqliteBindTextString(statement, 3, "published", -1)
    unused SqliteBindTextString(statement, 4, TextUntilNul(row.topic[:]), -1)
    unused SqliteBindTextString(statement, 5, TextUntilNul(row.description[:]), -1)
    unused SqliteBindInt(statement, 6, row.proposal_minutes)
    unused SqliteBindInt(statement, 7, row.voting_minutes)
    unused SqliteBindInt(statement, 8, row.negative_weight)
    unused SqliteBindInt(statement, 9, row.quorum_votes)
    unused SqliteBindTextString(statement, 10, TextUntilNul(row.visibility[:]), -1)
    unused SqliteBindTextString(statement, 11, TextUntilNul(row.proposal_visibility[:]), -1)
    unused SqliteBindTextString(statement, 12, TextUntilNul(row.proposal_access[:]), -1)
    unused SqliteBindTextString(statement, 13, TextUntilNul(row.voting_access[:]), -1)
    unused SqliteBindTextString(statement, 14, TextUntilNul(row.local_address[:]), -1)
    unused SqliteBindInt64(statement, 15, row.created_at)
    unused SqliteBindTextString(statement, 16, TextUntilNul(row.owner[:]), -1)
    inserted := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return inserted
}

// Saves a newly created process in one transaction: the process, then its
// options (ranked) or proposals (consent), all as the owner's. A consent
// process without proposals starts with the two standing ones.
StorageSaveNewProcess :: (row: ProcessRow, owner_name: string, standing: StandingProposals) -> bool {
    if database == null || SqliteExecText(database, "begin immediate") != SQLITE_OK {
        return false
    }
    process_id := TextUntilNul(row.id[:])
    owner := TextUntilNul(row.owner[:])
    saved := StorageInsertProcessRow(row)
    if saved && ProcessHasOptions(row.type) {
        index: s32 = 0
        while saved && index < process.option_count {
            saved = StorageInsertOption(process_id, process.options[index], index)
            index += 1
        }
    }
    if saved && row.type == ProcessType.ProcessConsent {
        if process.proposal_count > 0 {
            index: s32 = 0
            while saved && index < process.proposal_count {
                proposal := process.proposals[index]
                saved = StorageInsertProposal(process_id, owner, owner_name, TextUntilNul(proposal.title[:]), TextUntilNul(proposal.description[:]), row.created_at, true) >= 0
                index += 1
            }
        } else {
            saved = StorageInsertProposal(process_id, owner, "", standing.status_quo_title, standing.status_quo_description, row.created_at, true) >= 0
            if saved {
                saved = StorageInsertProposal(process_id, owner, "", standing.repeat_title, standing.repeat_description, row.created_at, true) >= 0
            }
        }
    }
    if saved {
        saved = SqliteExecText(database, "commit") == SQLITE_OK
    }
    if !saved {
        unused SqliteExecText(database, "rollback")
    }
    return saved
}

// The settings a stored process row carries.
ProcessSettingsFromRow :: (row: ProcessRow) -> ProcessSettings {
    settings: ProcessSettings
    settings.id = row.id
    settings.owner = row.owner
    settings.type = row.type
    settings.topic = row.topic
    settings.description = row.description
    settings.visibility = row.visibility
    settings.proposal_visibility = row.proposal_visibility
    settings.proposal_access = row.proposal_access
    settings.voting_access = row.voting_access
    settings.proposal_minutes = row.proposal_minutes
    settings.voting_minutes = row.voting_minutes
    settings.negative_weight = row.negative_weight
    settings.quorum_votes = row.quorum_votes
    return settings
}

StorageAddProposal :: (id: string, title: string, description: string) -> s32 {
    if process.proposal_count >= MAX_PROPOSALS {
        return -1
    }
    index := process.proposal_count
    process.proposals[index] = Proposal.{}
    SetText(process.proposals[index].id[:], id)
    SetText(process.proposals[index].title[:], title)
    SetText(process.proposals[index].description[:], description)
    process.proposal_count += 1
    return index
}

StorageLoadOptions :: (process_id: string) {
    statement: *void = null
    if SqlitePrepareText(database, "select id, label, description from options where process_id=? order by position, id", -1, *statement, null) != SQLITE_OK {
        return
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    while process.option_count < MAX_OPTIONS && SqliteStep(statement) == SQLITE_ROW {
        option: Option
        StorageColumnText(statement, 0, "", option.id[:])
        StorageColumnText(statement, 1, "", option.label[:])
        StorageColumnText(statement, 2, "", option.description[:])
        process.options[process.option_count] = option
        process.option_count += 1
    }
    unused SqliteFinalize(statement)
}

// A proposal keeps the server's id once synced, and "local-<rowid>" before.
StorageLoadProposals :: (process_id: string) {
    statement: *void = null
    if SqlitePrepareText(database, "select id, author_user_id, remote_id, title, description, display_name from proposals where process_id=? order by created_at, id", -1, *statement, null) != SQLITE_OK {
        return
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    while process.proposal_count < MAX_PROPOSALS && SqliteStep(statement) == SQLITE_ROW {
        proposal: Proposal
        StorageColumnText(statement, 2, "", proposal.id[:])
        if proposal.id[0] == cast(u8)0 {
            local: [24]u8
            number: [24]u8
            length := TextAppend(local[:], 0, "local-")
            unused TextAppend(local[:], length, FormatInteger(SqliteColumnInt64(statement, 0), number[:]))
            unused CopyCString(TextUntilNul(local[:]), proposal.id[:])
        }
        StorageColumnText(statement, 1, "", proposal.author[:])
        StorageColumnText(statement, 3, "", proposal.title[:])
        StorageColumnText(statement, 4, "", proposal.description[:])
        StorageColumnText(statement, 5, "", proposal.display_name[:])
        process.proposals[process.proposal_count] = proposal
        process.proposal_count += 1
    }
    unused SqliteFinalize(statement)
}

StorageLoadVotes :: (process_id: string) {
    statement: *void = null
    if SqlitePrepareText(database, "select voter_user_id, display_name, scores, updated_at from votes where process_id=? order by updated_at", -1, *statement, null) != SQLITE_OK {
        return
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    while SqliteStep(statement) == SQLITE_ROW {
        voter: [65]u8
        display_name: [80]u8
        StorageColumnText(statement, 0, "", voter[:])
        StorageColumnText(statement, 1, "", display_name[:])
        participant := ProcessParticipantAdd(TextUntilNul(voter[:]), TextUntilNul(display_name[:]), true)
        if participant >= 0 {
            number: [24]u8
            SetText(process.participants[participant].updated_at[:], FormatInteger(SqliteColumnInt64(statement, 3), number[:]))
            ballot := SqliteColumnText(statement, 2)
            if ballot != null {
                ProcessApplyBallot(participant, TextFromCString(ballot))
            }
        }
    }
    unused SqliteFinalize(statement)
}

// Loads a stored process with its options, proposals, and ballots into
// `process`. A consent process without stored proposals shows the two
// standing ones. Proposal authors take part before they vote.
StorageLoadProcessDetail :: (row: ProcessRow, standing: StandingProposals) -> bool {
    ProcessClear()
    if database == null || row.id[0] == cast(u8)0 {
        return false
    }
    process.settings = ProcessSettingsFromRow(row)
    process_id := TextUntilNul(row.id[:])
    StorageLoadOptions(process_id)
    StorageLoadProposals(process_id)
    if row.type == ProcessType.ProcessConsent && process.proposal_count == 0 {
        unused StorageAddProposal("status-quo", standing.status_quo_title, standing.status_quo_description)
        unused StorageAddProposal("repeat-process", standing.repeat_title, standing.repeat_description)
    }
    StorageLoadVotes(process_id)
    index: s32 = 0
    while index < process.proposal_count {
        unused ProcessParticipantAdd(TextUntilNul(process.proposals[index].author[:]), TextUntilNul(process.proposals[index].display_name[:]), false)
        index += 1
    }
    return true
}

// The id a proposal has before the server gives it one.
StorageLocalProposalId :: (rowid: s64, output: []u8) -> string {
    number: [24]u8
    length := TextAppend(output, 0, "local-")
    unused TextAppend(output, length, FormatInteger(rowid, number[:]))
    return TextUntilNul(output)
}

// Saves a proposal written here, not yet synced. Returns its rowid, or -1.
StorageSaveLocalProposal :: (process_id: string, author: string, display_name: string, title: string, description: string, now: s64) -> s64 {
    if database == null || !StorageHasText(title) {
        return -1
    }
    return StorageInsertProposal(process_id, author, display_name, title, description, now, false)
}

// Saves this participant's ballot, replacing an earlier one; it waits to
// be synced.
StorageSaveLocalVote :: (process_id: string, voter: string, display_name: string, ballot: string, now: s64) -> bool {
    if database == null || voter.count == 0 {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, "insert into votes(process_id, voter_user_id, display_name, reason, scores, updated_at, synced) values(?, ?, ?, ?, ?, ?, 0) on conflict(process_id, voter_user_id) do update set display_name=excluded.display_name, reason=excluded.reason, scores=excluded.scores, updated_at=excluded.updated_at, synced=0", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    unused SqliteBindTextString(statement, 2, voter, -1)
    unused SqliteBindTextString(statement, 3, display_name, -1)
    unused SqliteBindTextString(statement, 4, "", -1)
    unused SqliteBindTextString(statement, 5, ballot, -1)
    unused SqliteBindInt64(statement, 6, now)
    saved := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return saved
}

StorageExecWithId :: (sql: string, id: string) -> bool {
    if database == null {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, sql, -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, id, -1)
    done := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return done
}

StorageMarkProcessSynced :: (process_id: string) -> bool {
    return StorageExecWithId("update processes set synced=1 where id=?", process_id)
}

StorageProcessSynced :: (process_id: string) -> bool {
    if database == null {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, "select synced from processes where id=?", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    synced := SqliteStep(statement) == SQLITE_ROW && SqliteColumnInt(statement, 0) != 0
    unused SqliteFinalize(statement)
    return synced
}

// Changes to the process, its proposals, and its ballots waiting to sync.
StoragePendingCount :: (process_id: string) -> s32 {
    if database == null {
        return 0
    }
    statement: *void = null
    if SqlitePrepareText(database, "select (select count(*) from processes where id=?1 and synced=0) + (select count(*) from proposals where process_id=?1 and synced=0) + (select count(*) from votes where process_id=?1 and synced=0)", -1, *statement, null) != SQLITE_OK {
        return 0
    }
    unused SqliteBindTextString(statement, 1, process_id, -1)
    count: s32 = 0
    if SqliteStep(statement) == SQLITE_ROW {
        count = SqliteColumnInt(statement, 0)
    }
    unused SqliteFinalize(statement)
    return count
}

// Records the server's id for a proposal written here.
StorageMarkProposalSynced :: (rowid: s64, remote_id: string) -> bool {
    if database == null {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, "update proposals set synced=1, remote_id=? where id=?", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, remote_id, -1)
    unused SqliteBindInt64(statement, 2, rowid)
    done := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return done
}

// Renames a proposal in every stored ballot of the process, as when a local
// proposal gets its server id. A ballot whose renamed form would not fit is
// left as it was, and the result is false.
StorageRewriteBallotId :: (process_id: string, old_id: string, new_id: string) -> bool {
    if database == null {
        return false
    }
    select: *void = null
    update: *void = null
    if SqlitePrepareText(database, "select voter_user_id, scores from votes where process_id=?", -1, *select, null) != SQLITE_OK {
        return false
    }
    if SqlitePrepareText(database, "update votes set scores=? where process_id=? and voter_user_id=?", -1, *update, null) != SQLITE_OK {
        unused SqliteFinalize(select)
        return false
    }
    unused SqliteBindTextString(select, 1, process_id, -1)
    all := true
    while SqliteStep(select) == SQLITE_ROW {
        voter := SqliteColumnText(select, 0)
        ballot := SqliteColumnText(select, 1)
        renamed: [8192]u8
        length: s64 = -1
        if voter != null && ballot != null {
            length = BallotReplaceId(TextFromCString(ballot), old_id, new_id, renamed[:])
        }
        if length < 0 {
            all = false
        } else {
            unused SqliteReset(update)
            unused SqliteClearBindings(update)
            unused SqliteBindTextString(update, 1, TextUntilNul(renamed[:]), -1)
            unused SqliteBindTextString(update, 2, process_id, -1)
            unused SqliteBindTextString(update, 3, TextFromCString(voter), -1)
            if SqliteStep(update) != SQLITE_DONE {
                all = false
            }
        }
    }
    unused SqliteFinalize(update)
    unused SqliteFinalize(select)
    return all
}

// The sync account: its keys, the server's bearer token, and the server.
StoredAccount :: struct {
    keys: AccountKeys
    auth_token: [768]u8
    server_url: [256]u8
    loaded: bool
}

// Loads the account; `loaded` is false when there is none or its keys do
// not form a valid key pair.
StorageLoadAccount :: () -> StoredAccount {
    account: StoredAccount
    if database == null {
        return account
    }
    statement: *void = null
    if SqlitePrepareText(database, "select public_id, public_key, private_key, auth_token, server_url from account where id=1", -1, *statement, null) != SQLITE_OK {
        return account
    }
    if SqliteStep(statement) == SQLITE_ROW {
        StorageColumnText(statement, 0, "", account.keys.public_id[:])
        StorageColumnText(statement, 1, "", account.keys.public_key_hex[:])
        StorageColumnText(statement, 2, "", account.keys.private_key_hex[:])
        StorageColumnText(statement, 3, "", account.auth_token[:])
        StorageColumnText(statement, 4, "https://api.waozi.xyz", account.server_url[:])
        account.loaded = ValidateAccountKeys(*account.keys) != 0
    }
    unused SqliteFinalize(statement)
    return account
}

// Saves valid keys with the bearer token. As before, saving replaces the
// row, so the server address returns to its default.
StorageSaveAccount :: (keys: AccountKeys, auth_token: string) -> bool {
    if database == null {
        return false
    }
    checked := keys
    if ValidateAccountKeys(*checked) == 0 {
        return false
    }
    statement: *void = null
    if SqlitePrepareText(database, "insert or replace into account(id, public_id, public_key, private_key, auth_token) values(1, ?, ?, ?, ?)", -1, *statement, null) != SQLITE_OK {
        return false
    }
    unused SqliteBindTextString(statement, 1, TextUntilNul(keys.public_id[:]), -1)
    unused SqliteBindTextString(statement, 2, TextUntilNul(keys.public_key_hex[:]), -1)
    unused SqliteBindTextString(statement, 3, TextUntilNul(keys.private_key_hex[:]), -1)
    unused SqliteBindTextString(statement, 4, auth_token, -1)
    saved := SqliteStep(statement) == SQLITE_DONE
    unused SqliteFinalize(statement)
    return saved
}

// The settings key of one field of a process's guest key pair, as the C
// client named it: "guest.<process id>.<field>".
GuestSettingKey :: (process_id: string, field: string, output: []u8) -> string {
    output[0] = cast(u8)0
    length := TextAppend(output, 0, "guest.")
    length = TextAppend(output, length, process_id)
    length = TextAppend(output, length, ".")
    length = TextAppend(output, length, field)
    if length < 0 {
        output[0] = cast(u8)0
        return ""
    }
    return TextUntilNul(output)
}

// The public id that owns a new process: the account's, or else a key pair
// made for this process alone and kept in settings, as the C client did.
// Returns "" when no key pair can be made or saved.
StorageProcessOwner :: (process_id: string, output: []u8) -> string {
    output[0] = cast(u8)0
    account := StorageLoadAccount()
    if account.loaded {
        unused TextAppend(output, 0, TextUntilNul(account.keys.public_id[:]))
        return TextUntilNul(output)
    }
    key: [96]u8
    {
        existing := SettingLoadText(GuestSettingKey(process_id, "public_id", key[:]), "", output)
        if existing.count > 0 {
            return existing
        }
    }
    keys: AccountKeys
    if CreateAccountKeys(*keys) == 0 {
        return ""
    }
    saved := SettingSaveText(GuestSettingKey(process_id, "public_key", key[:]), TextUntilNul(keys.public_key_hex[:]))
    saved = saved && SettingSaveText(GuestSettingKey(process_id, "private_key", key[:]), TextUntilNul(keys.private_key_hex[:]))
    saved = saved && SettingSaveText(GuestSettingKey(process_id, "token", key[:]), "")
    saved = saved && SettingSaveText(GuestSettingKey(process_id, "public_id", key[:]), TextUntilNul(keys.public_id[:]))
    if !saved {
        return ""
    }
    unused TextAppend(output, 0, TextUntilNul(keys.public_id[:]))
    return TextUntilNul(output)
}

AppendHex32 :: (output: []u8, length: s64, value: u32) -> s64 {
    digits: [9]u8
    shift: s32 = 28
    index: s32 = 0
    while index < 8 {
        nibble := (value >> cast(u32)shift) & cast(u32)15
        if nibble < cast(u32)10 {
            digits[index] = cast(u8)(48 + cast(s32)nibble)
        } else {
            digits[index] = cast(u8)(87 + cast(s32)nibble)
        }
        shift -= 4
        index += 1
    }
    return TextAppend(output, length, TextView(digits[0:8]))
}

// A new process id as the C client made them: the creation time and a random
// number, each as eight hex digits ("66f9a2b1-3c0d9e7f").
StorageNewProcessId :: (now: s64, output: []u8) -> string {
    output[0] = cast(u8)0
    random: [4]u8
    if SecureRandom(*random[0], 4) == 0 {
        return ""
    }
    value := (cast(u32)random[0] << cast(u32)24) | (cast(u32)random[1] << cast(u32)16) | (cast(u32)random[2] << cast(u32)8) | cast(u32)random[3]
    value = value & cast(u32)0x7fffffff
    length := AppendHex32(output, 0, cast(u32)now)
    length = TextAppend(output, length, "-")
    length = AppendHex32(output, length, value)
    if length < 0 {
        output[0] = cast(u8)0
        return ""
    }
    return TextUntilNul(output)
}
