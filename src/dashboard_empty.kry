#import "kryon.h"

UkuDashboardEmptyPanel :: (message: const char *, x: int, y: int, w: int, body_font: int) -> int #export {
    pad: int = Scale(12)
    h: int = Scale(76)
    DrawRectangleLines(x, y, w, h, StyleTokenColor("muted"))
    DrawRectangle(x + 1, y + 1, w - 2, h - 2, StyleTokenColor("surface"))
    DrawFittedTextInRect(message,(Rectangle){(float)(x + pad),(float)(y + pad),(float)(w - pad * 2),(float)(h - pad * 2)},body_font,Text12,StyleTokenColor("text"))
    return y + h + Scale(12)
}
