#import "ballot"
#import "tally"
#import "std/text_buffer"

// A stored decision, its proposals and each participant's scores.
// Existing ranked decisions retain their saved options.

MAX_PROPOSALS :: 64
MAX_OPTIONS :: 5
MAX_VOTES :: 1024

ProcessType :: enum {
    ProcessConsent :: 0
    ProcessRanked :: 1
    ProcessCollection :: 2
}

ProcessSettings :: struct {
    id: [40]u8
    type: ProcessType
    topic: [180]u8
    description: [420]u8
    proposal_minutes: s32
    voting_minutes: s32
    negative_weight: s32
    quorum_votes: s32
}

Proposal :: struct {
    id: [40]u8
    author: [65]u8
    display_name: [80]u8
    title: [180]u8
    description: [420]u8
}

Option :: struct {
    id: [40]u8
    label: [180]u8
    description: [420]u8
}

Participant :: struct {
    id: [65]u8
    display_name: [80]u8
    updated_at: [64]u8
    has_ballot: bool
    // Left out of the results by whoever reads them; every ballot counts
    // by default.
    excluded: bool
}

ProcessDetail :: struct {
    settings: ProcessSettings
    proposals: [MAX_PROPOSALS]Proposal
    proposal_count: s32
    options: [MAX_OPTIONS]Option
    option_count: s32
    participants: [MAX_VOTES]Participant
    participant_count: s32
    // Each participant's score per proposal and per option; SCORE_UNSET when
    // they did not score it.
    proposal_scores: [MAX_VOTES][MAX_PROPOSALS]s8
    option_scores: [MAX_VOTES][MAX_OPTIONS]s8
}

process: ProcessDetail;

// Canonical process types.
ProcessTypeFromKey :: (key: string) -> ProcessType {
    if key == "ranked_choice" {
        return ProcessType.ProcessRanked
    }
    if key == "collection" {
        return ProcessType.ProcessCollection
    }
    return ProcessType.ProcessConsent
}

ProcessTypeKey :: (type: ProcessType) -> string {
    if type == ProcessType.ProcessRanked {
        return "ranked_choice"
    }
    if type == ProcessType.ProcessCollection {
        return "collection"
    }
    return "consent"
}

ProcessHasOptions :: (type: ProcessType) -> bool {
    return type == ProcessType.ProcessRanked
}

ProcessUsesNegativeWeight :: (type: ProcessType) -> bool {
    return type == ProcessType.ProcessConsent
}

SetText :: (output: []u8, value: string) {
    if output.count == 0 {
        return
    }
    length: s64 = value.count
    if length > output.count - 1 {
        length = output.count - 1
    }
    index: s64 = 0
    while index < length {
        output[index] = value[index]
        index += 1
    }
    output[length] = cast(u8)0
}

ProcessClear :: () {
    process = ProcessDetail.{}
}

ProcessParticipantFind :: (id: string) -> s32 {
    index: s32 = 0
    while index < process.participant_count {
        if TextUntilNul(process.participants[index].id[:]) == id {
            return index
        }
        index += 1
    }
    return -1
}

// Adds a participant, or finds them again. A proposal author takes part
// without a ballot until their vote arrives. Returns -1 when the process
// is full or the id is empty.
ProcessParticipantAdd :: (id: string, display_name: string, has_ballot: bool) -> s32 {
    if id.count == 0 {
        return -1
    }
    index := ProcessParticipantFind(id)
    if index < 0 {
        if process.participant_count >= MAX_VOTES {
            return -1
        }
        index = process.participant_count
        process.participant_count += 1
        process.participants[index] = Participant.{}
        SetText(process.participants[index].id[:], id)
        column: s32 = 0
        while column < MAX_PROPOSALS {
            process.proposal_scores[index][column] = cast(s8)SCORE_UNSET
            column += 1
        }
        column = 0
        while column < MAX_OPTIONS {
            process.option_scores[index][column] = cast(s8)SCORE_UNSET
            column += 1
        }
    }
    if display_name.count > 0 && process.participants[index].display_name[0] == cast(u8)0 {
        SetText(process.participants[index].display_name[:], display_name)
    }
    if has_ballot {
        process.participants[index].has_ballot = true
    }
    return index
}

ProcessProposalFind :: (id: string) -> s32 {
    index: s32 = 0
    while index < process.proposal_count {
        if TextUntilNul(process.proposals[index].id[:]) == id {
            return index
        }
        index += 1
    }
    return -1
}

ProcessOptionFind :: (id: string) -> s32 {
    index: s32 = 0
    while index < process.option_count {
        if TextUntilNul(process.options[index].id[:]) == id {
            return index
        }
        index += 1
    }
    return -1
}

ProcessBallotCounts :: (index: s32) -> bool {
    return process.participants[index].has_ballot && !process.participants[index].excluded
}

// The ballots that count toward the results.
ProcessIncludedBallots :: () -> s32 {
    count: s32 = 0
    index: s32 = 0
    while index < process.participant_count {
        if ProcessBallotCounts(index) {
            count += 1
        }
        index += 1
    }
    return count
}

// True when a ballot is left out, so the results show a subset.
ProcessSubsetActive :: () -> bool {
    index: s32 = 0
    while index < process.participant_count {
        if process.participants[index].has_ballot && process.participants[index].excluded {
            return true
        }
        index += 1
    }
    return false
}

// Totals per proposal from the counted ballots, in proposal order.
ProcessProposalTally :: (proposal: s32) -> ProposalTally {
    tally: ProposalTally
    voter: s32 = 0
    while voter < process.participant_count {
        if ProcessBallotCounts(voter) {
            tally = TallyWithScore(tally, cast(s32)process.proposal_scores[voter][proposal], process.settings.negative_weight)
        }
        voter += 1
    }
    return tally
}

ProcessOptionTally :: (option: s32) -> OptionTally {
    tally: OptionTally
    voter: s32 = 0
    while voter < process.participant_count {
        if ProcessBallotCounts(voter) {
            tally = OptionTallyWithScore(tally, cast(s32)process.option_scores[voter][option])
        }
        voter += 1
    }
    return tally
}

// Copies text[start:end] into output; false when it does not fit.
CopyRange :: (text: string, start: s64, end: s64, output: []u8) -> bool {
    length := end - start
    if length < 0 || length + 1 > output.count {
        return false
    }
    index: s64 = 0
    while index < length {
        output[index] = text[start + index]
        index += 1
    }
    output[length] = cast(u8)0
    return true
}

// Fills the participant's scores from a stored ballot ("id=score;..."),
// by proposal or option id. Unknown ids and invalid scores are ignored.
ProcessApplyBallot :: (participant: s32, ballot: string) {
    options := ProcessHasOptions(process.settings.type)
    id: [40]u8
    at: s64 = 0
    while at < ballot.count {
        entry := BallotEntryAt(ballot, at)
        if !entry.valid {
            return
        }
        if ScoreIsValid(entry.score) && CopyRange(ballot, entry.id_start, entry.id_end, id[:]) {
            if options {
                index := ProcessOptionFind(TextUntilNul(id[:]))
                if index >= 0 {
                    process.option_scores[participant][index] = cast(s8)entry.score
                }
            } else {
                index := ProcessProposalFind(TextUntilNul(id[:]))
                if index >= 0 {
                    process.proposal_scores[participant][index] = cast(s8)entry.score
                }
            }
        }
        at = entry.next
    }
}
