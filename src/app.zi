// Ukuvota on Kryon: the host calls Frame for every frame.
using UI :: #import "kryon/Widgets";
#import "app_state"
#import "collect_view"
#import "create_view"
#import "home_view"
#import "manual_view"
#import "settings_view"
#import "locale"
#import "storage"
#import "platform"
#import "theme"
#import "ui_kit"
#import "kryon/ScrollDevice"
#import "std/date_time_linux"
#if #defined(PLATFORM_WEB) {
    #import "browser_input"
}

initialized: bool;
storage_ready: bool;

Initialize :: () {
    storage_ready = StorageOpen(DataPath())
    if storage_ready {
        language: [16]u8
        unused LocaleSelect(SettingLoadText("locale", "en", language[:]))
        unused StorageLoadProcesses()
        ThemeSetMode(SettingLoadInt("theme_mode", 0))
    }
}

Background :: (session: Session, viewport: Rectangle) {
    props: BoxProps
    props.key = cast(u64)1
    props.bounds = viewport
    props.fill = ThemeBackground()
    props.border = ThemeBackground()
    Box(session, props)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if !initialized {
        Initialize()
        initialized = true
    }
    ThemeUpdate()
    UiBeginFrame(session)
    pointer := PointerSample(session)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down, pointer.released, PointerWheelTake(session, viewport), 0.0)
    Background(session, viewport)
    ShowKeyboard(focused_field >= 0)
    if !storage_ready {
        column := UiColumn(viewport, 520.0)
        unused UiParagraph(session, Tr("db_error"), column.x, viewport.y + 48.0, column.width, 16)
        return 0
    }
    if PersistenceFailed() {
        height := UiParagraph(session, Tr("persistence_error"), viewport.x + 16.0, viewport.y + 8.0, viewport.width - 32.0, 14) + 16.0
        viewport.y += height
        viewport.height -= height
    }
    now := UnixNow()
    #if #defined(PLATFORM_WEB) {
        BrowserInputsBegin(viewport)
    }
    if screen == ScreenId.ScreenHome {
        HomeView(session, viewport, now)
    } else if screen == ScreenId.ScreenCreate {
        CreateView(session, viewport, now)
    } else if screen == ScreenId.ScreenCollect {
        CollectView(session, viewport, now)
    } else if screen == ScreenId.ScreenSettings {
        SettingsView(session, viewport)
    } else {
        ManualView(session, viewport)
    }
    #if #defined(PLATFORM_WEB) {
        BrowserInputsEnd()
    }
    return 0
}
