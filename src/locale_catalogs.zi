LocaleFill_it :: () {
    LocaleAdd("home_title", "Cruscotto")
    LocaleAdd("start_process_button", "Crea processo")
    LocaleAdd("dashboard_empty", "Nessun processo attivo.")
    LocaleAdd("manual_title", "Manuale")
    LocaleAdd("manual_body", "Le decisioni sono salvate su questo dispositivo. La condivisione online non è ancora collegata. Create un processo con una domanda chiara e raccogliete proposte.\n\nOgni nuovo processo include Status quo e Ripeti processo. Votate da -3 (forte resistenza) a +3 (forte sostegno); il trattino indica astensione. I punteggi negativi sono ponderati.\n\nSalvate ogni voto prima di Prossimo partecipante. Ogni persona ha una propria identità locale. Toccate una persona salvata per modificarne il voto. Cambiare nome non seleziona un altro votante.\n\nI risultati mostrano parità e quorum. Tutti i voti contano per impostazione predefinita; le caselle consentono di esplorare un sottoinsieme.")
    LocaleAdd("create_title", "Configurazione decisione")
    LocaleAdd("topic_question_label", "Domanda del tema")
    LocaleAdd("topic_question_placeholder", "Che cosa deve decidere questo gruppo?")
    LocaleAdd("topic_error", "Aggiungi una domanda per avviare il processo.")
