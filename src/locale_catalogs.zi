    LocaleAdd("description_label", "Descrizione (opzionale)")
    LocaleAdd("description_placeholder", "Aggiungi contesto, vincoli o link.")
    LocaleAdd("negative_weight_label", "Peso dei punteggi negativi")
    LocaleAdd("negative_weight_infinity", "Infinito (consenso sistemico)")
