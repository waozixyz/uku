// Fills locale_filling for a language code; false for an unknown code.
LocaleCatalogFill :: (code: string) -> bool {
    locale_filling.count = 0
    if code == "en" {
        LocaleFill_en()
        return true
    }
    if code == "es" {
        LocaleFill_es()
        return true
    }
    if code == "cs" {
        LocaleFill_cs()
        return true
    }
    if code == "de" {
        LocaleFill_de()
        return true
    }
    if code == "fr" {
        LocaleFill_fr()
        return true
    }
    if code == "id" {
        LocaleFill_id()
        return true
    }
    if code == "it" {
        LocaleFill_it()
        return true
    }
    if code == "pt" {
        LocaleFill_pt()
        return true
    }
    if code == "ru" {
        LocaleFill_ru()
        return true
    }
    if code == "ja" {
        LocaleFill_ja()
        return true
    }
    if code == "ko" {
        LocaleFill_ko()
        return true
    }
    if code == "zh" {
        LocaleFill_zh()
        return true
    }
    return false
}
