// Uku draws with Kryon's classic style in the desktop's colors or in a
// chosen light or dark palette, and keeps the palette for the panels it
// paints itself.
using UI :: #import "kryon/Widgets";
SystemStyle :: #import "kss/SystemStyle";
SystemThemeLinux :: #import "kryon/SystemThemeLinux";
#import "kryon/system_theme"
#import "text_append"
#import "std/text_buffer"
#import "platform"

theme_palette: SystemPalette;
// ThemePolicy: 0 follows the desktop, 1 is light, 2 is dark.
theme_mode: s32;
theme_name: [128]u8;
theme_installed: bool;
theme_frames: s32;

ThemeSetMode :: (mode: s32) {
    if mode < 0 || mode > 2 {
        mode = 0
    }
    theme_mode = mode
    theme_installed = false
    theme_frames = 0
}

// Installs the chosen light or dark style, or follows the desktop theme,
// which it reads on the first frame and then about every two seconds.
ThemeUpdate :: () {
    if theme_mode != 0 {
        if theme_installed {
            return
        }
        theme_palette = SystemPaletteFallback(theme_mode == 2)
        unused SystemStyle.StyleInstallSystem(theme_palette)
        theme_name[0] = cast(u8)0
        theme_installed = true
        return
    }
    if theme_installed {
        theme_frames += 1
        if theme_frames < 120 {
            return
        }
        theme_frames = 0
    }
    #if #defined(PLATFORM_WEB) {
        theme_palette = SystemPaletteFallback(BrowserPrefersDark())
        unused SystemStyle.StyleInstallSystem(theme_palette)
        theme_installed = true
        return
    }
    #if #defined(ANDROID_BUILD) {
        theme_palette = SystemPaletteFallback(false)
        unused SystemStyle.StyleInstallSystem(theme_palette)
        theme_installed = true
        return
    }
    name := SystemThemeLinux.SystemThemeName()
    if theme_installed && name == TextUntilNul(theme_name[:]) {
        return
    }
    theme_palette = SystemThemeLinux.SystemPaletteRead()
    unused SystemStyle.StyleInstallSystem(theme_palette)
    theme_name[0] = cast(u8)0
    unused TextAppend(theme_name[:], 0, name)
    theme_installed = true
}

ThemeBackground :: () -> Color {
    return ColorFromPacked(theme_palette.background)
}

// A panel just off the background, as the classic style's "surface".
ThemeSurface :: () -> Color {
    return ColorFromPacked(CssMix(theme_palette.background, theme_palette.text, 0.05))
}

ThemeBorder :: () -> Color {
    return ColorFromPacked(CssMix(theme_palette.background, theme_palette.text, 0.16))
}
