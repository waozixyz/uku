// Uku's building blocks over Kryon's widgets: text, buttons, panels, and text
// fields fed with the frame's keyboard input.
using UI :: #import "kryon/Widgets";
#import "theme"
#import "locale"
#import "std/text_buffer"
#import "std/number_text"
#import "std/c_string"

FIELD_LIMIT :: 32

FieldState :: struct {
    cursor: s32
    anchor: s32
    scroll_x: s32
}

frame_key: s32;
frame_modifiers: s32;
frame_typed_count: s64;
typed_storage: [256]u8;
// The field that receives typing, or -1.
focused_field: s32 = -1;
field_states: [FIELD_LIMIT]FieldState;

// Reads this frame's key, modifiers, and typed text once for every field.
UiBeginFrame :: (session: Session) {
    frame_key = KeyboardTake(session)
    frame_modifiers = KeyboardModifiers(session)
    typed := TypedTextTake(session, typed_storage[:])
    frame_typed_count = cast(s64)typed.count
}

UiTextProps :: (value: string, bounds: Rectangle, font: s32, wrap: TextWrap) -> TextProps {
    props: TextProps
    props.bounds = bounds
    props.text = value
    props.font = font
    props.wrap = wrap
    return props
}

// The height text takes when wrapped to width.
UiTextHeight :: (value: string, width: float32, font: s32) -> float32 {
    props := UiTextProps(value, Rectangle.{0.0, 0.0, width, 0.0}, font, TextWrap.TextWrapAuto)
    prepared := PrepareText(props, TextFaceFor(props, DefaultTextFace()))
    return prepared.bounds.height
}

// One line of text.
UiText :: (session: Session, value: string, bounds: Rectangle, font: s32) {
    Text(session, UiTextProps(value, bounds, font, TextWrap.TextWrapNone))
}

UiCenteredText :: (session: Session, value: string, bounds: Rectangle, font: s32) {
    props := UiTextProps(value, bounds, font, TextWrap.TextWrapAuto)
    props.align = TextAlign.TextAlignCenter
    Text(session, props)
}

// Wrapped text at x and y; returns the height it took.
UiParagraph :: (session: Session, value: string, x: float32, y: float32, width: float32, font: s32) -> float32 {
    height := UiTextHeight(value, width, font)
    Text(session, UiTextProps(value, Rectangle.{x, y, width, height}, font, TextWrap.TextWrapAuto))
    return height
}

UiButton :: (session: Session, id: s32, label: string, bounds: Rectangle, accent: bool) -> bool {
    props: ButtonProps
    props.key = cast(u64)id
    props.id = id
    props.bounds = bounds
    props.label = label
    props.tone = ButtonTone.ButtonToneNeutral
    props.emphasis = ButtonEmphasis.ButtonEmphasisSoft
    if accent {
        props.tone = ButtonTone.ButtonToneAccent
        props.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    }
    return Button(session, props) == 1
}

// A click target without its own drawing, laid over a panel.
UiHitArea :: (session: Session, id: s32, label: string, bounds: Rectangle) -> bool {
    props: ButtonProps
    props.key = cast(u64)id
    props.id = id
    props.bounds = bounds
    props.label = label
    props.invisible = true
    return Button(session, props) == 1
}

UiPanel :: (session: Session, key: u64, bounds: Rectangle) {
    props: BoxProps
    props.key = key
    props.bounds = bounds
    props.fill = ThemeSurface()
    props.border = ThemeBorder()
    props.radius = 10.0
    Box(session, props)
}

UiRule :: (session: Session, key: u64, x: float32, y: float32, width: float32) {
    props: BoxProps
    props.key = key
    props.bounds = Rectangle.{x, y, width, 1.0}
    props.fill = ThemeBorder()
    props.border = ThemeBorder()
    Box(session, props)
}

// A small section heading over a hairline; returns the height it took.
UiSection :: (session: Session, key: u64, label: string, x: float32, y: float32, width: float32) -> float32 {
    UiText(session, label, Rectangle.{x, y, width, 18.0}, 13)
    UiRule(session, key, x, y + 24.0, width)
    return 36.0
}

// Applies a text field's edit to a NUL-terminated buffer. An edit whose
// result would not fit is dropped.
UiApplyEdit :: (buffer: []u8, edit: TextFieldEdit) -> bool {
    if !edit.changed {
        return false
    }
    length := cast(s32)TextUntilNul(buffer).count
    if edit.start < 0 || edit.end < edit.start || edit.end > length {
        return false
    }
    inserted := cast(s32)edit.replacement.count
    new_length := length - (edit.end - edit.start) + inserted
    if new_length + 1 > cast(s32)buffer.count {
        return false
    }
    tail_from := edit.end
    tail_to := edit.start + inserted
    tail_count := length - edit.end
    if tail_to > tail_from {
        index := tail_count - 1
        while index >= 0 {
            buffer[tail_to + index] = buffer[tail_from + index]
            index -= 1
        }
    } else if tail_to < tail_from {
        index: s32 = 0
        while index < tail_count {
            buffer[tail_to + index] = buffer[tail_from + index]
            index += 1
        }
    }
    index: s32 = 0
    while index < inserted {
        buffer[edit.start + index] = edit.replacement[index]
        index += 1
    }
    buffer[new_length] = cast(u8)0
    return true
}

// A one-line text field editing buffer; returns true when Enter commits it.
UiField :: (session: Session, index: s32, label: string, placeholder: string, buffer: []u8, bounds: Rectangle) -> bool {
    state := field_states[index]
    edit: TextFieldEdit
    replacement_storage: [1024]u8
    committed: bool
    {
        props: TextFieldProps
        props.key = cast(u64)(1000 + index)
        props.focus_id = 1000 + index
        props.bounds = bounds
        props.label = label
        props.placeholder = placeholder
        props.value = TextUntilNul(buffer)
        props.cursor = state.cursor
        props.anchor = state.anchor
        props.scroll_x = state.scroll_x
        props.focused = focused_field == index
        props.max_bytes = cast(s32)buffer.count - 1
        props.max_codepoints = props.max_bytes
        if props.focused {
            props.input = TextFieldInputFor(frame_key, frame_modifiers, TextView(typed_storage[0:frame_typed_count]))
        }
        result := TextField(session, props)
        state.cursor = result.cursor
        state.anchor = result.anchor
        state.scroll_x = result.scroll_x
        field_states[index] = state
        if result.focused {
            focused_field = index
        } else if focused_field == index {
            focused_field = -1
        }
        if result.escaped && focused_field == index {
            focused_field = -1
        }
        edit.start = result.edit.start
        edit.end = result.edit.end
        edit.changed = result.edit.changed
        if !CopyCString(result.edit.replacement, replacement_storage[:]) {
            return false
        }
        committed = result.committed
    }
    edit.replacement = TextUntilNul(replacement_storage[:])
    unused UiApplyEdit(buffer, edit)
    return committed
}

SUB_PAGE_BAR_HEIGHT :: 56.0

// A screen's title bar with a back button; returns true when back is clicked.
UiSubPageBar :: (session: Session, viewport: Rectangle, title: string) -> bool {
    UiRule(session, cast(u64)4501, viewport.x, viewport.y + SUB_PAGE_BAR_HEIGHT - 1.0, viewport.width)
    back := UiButton(session, 4502, Tr("back_button"), Rectangle.{viewport.x + 12.0, viewport.y + 10.0, 110.0, 36.0}, false)
    UiText(session, title, Rectangle.{viewport.x + 136.0, viewport.y + 17.0, viewport.width - 150.0, 24.0}, 18)
    if back {
        focused_field = -1
    }
    return back
}

// A centered column at most max_width wide inside the viewport.
UiColumn :: (viewport: Rectangle, max_width: float32) -> Rectangle {
    width := viewport.width - 32.0
    if width > max_width {
        width = max_width
    }
    return Rectangle.{viewport.x + (viewport.width - width) / 2.0, viewport.y, width, viewport.height}
}

// A row of mutually exclusive choices; returns the chosen index.
UiChoice :: (session: Session, id: s32, labels: []string, selected: s32, bounds: Rectangle) -> s32 {
    options: [8]SegmentOption
    count := cast(s32)labels.count
    if count > 8 {
        count = 8
    }
    index: s32 = 0
    while index < count {
        options[index].key = cast(u64)(id * 10 + index)
        options[index].label = labels[index]
        index += 1
    }
    props: SegmentedControlProps
    props.key = cast(u64)id
    props.id = id
    props.bounds = bounds
    props.selected_index = selected
    props.has_selection = true
    props.scale = 1.0
    result := SegmentedControl(session, props, options[0:count])
    if result.changed {
        return result.selected_index
    }
    return selected
}

// A labelled number with minus and plus buttons; returns the new value.
UiStepper :: (session: Session, id: s32, label: string, value: s32, low: s32, high: s32, x: float32, y: float32, width: float32) -> s32 {
    UiText(session, label, Rectangle.{x, y, width, 18.0}, 13)
    digits: [16]u8
    props: SpinboxProps
    props.key = cast(u64)id
    props.id = id
    props.label = label
    props.bounds = Rectangle.{x, y + 24.0, width, 38.0}
    props.value = value
    props.min = low
    props.max = high
    props.step = 1
    props.value_text = FormatInteger(cast(s64)value, digits[:])
    return Spinbox(session, props).value
}

// A label over a line of text; returns the height it took.
UiLabeledText :: (session: Session, label: string, value: string, x: float32, y: float32, width: float32) -> float32 {
    UiText(session, label, Rectangle.{x, y, width, 18.0}, 13)
    return 24.0 + UiParagraph(session, value, x, y + 24.0, width, 16)
}
