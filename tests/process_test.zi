#import "process"
#import "tally"
#import "std/text_buffer"

#program_export
ProcessAnswer :: () -> s32 {
    ProcessClear()
    process.settings.negative_weight = 3
    process.proposal_count = 2
    SetText(process.proposals[0].id[:], "p1")
    SetText(process.proposals[1].id[:], "p2")
    alice := ProcessParticipantAdd("alice", "Alice", false)
    bob := ProcessParticipantAdd("bob", "Bob", true)
    if alice < 0 || bob < 0 || ProcessParticipantAdd("alice", "", true) != alice || process.participant_count != 2 {
        return 1
    }
    ProcessApplyBallot(alice, "p1=3;p2=-2;gone=1")
    ProcessApplyBallot(bob, "p2=0;p1x=9")
    if process.proposal_scores[alice][0] != cast(s8)3 || process.proposal_scores[alice][1] != cast(s8)-2 {
        return 2
    }
    if process.proposal_scores[bob][0] != cast(s8)SCORE_UNSET || process.proposal_scores[bob][1] != cast(s8)0 {
        return 3
    }
    tally := ProcessProposalTally(1)
    if ProcessIncludedBallots() != 2 || tally.vote_count != 2 || tally.total != -6 {
        return 4
    }
    process.participants[alice].excluded = true
    tally = ProcessProposalTally(1)
    if !ProcessSubsetActive() || ProcessIncludedBallots() != 1 || tally.vote_count != 1 || tally.total != 0 {
        return 5
    }
    // Stored ranked decisions retain canonical type keys and option scores.
    if ProcessTypeFromKey("ranked_choice") != ProcessType.ProcessRanked || ProcessTypeKey(ProcessType.ProcessRanked) != "ranked_choice" {
        return 6
    }
    ProcessClear()
    process.settings.type = ProcessType.ProcessRanked
    process.option_count = 1
    SetText(process.options[0].id[:], "o1")
    voter := ProcessParticipantAdd("voter", "Voter", true)
    ProcessApplyBallot(voter, "o1=2")
    if process.option_scores[voter][0] != cast(s8)2 || ProcessOptionTally(0).total != 2 {
        return 7
    }
    return 42
}

#program_export
main :: () -> s32 {
    return ifx ProcessAnswer() == 42 then 0 else 1
}
