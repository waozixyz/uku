#import "sqlite/SQLite"
#import "storage"
#import "daochi_client/keys"
#import "ballot"
#import "process"
#import "tally"
#import "std/c_string"
#import "std/text_buffer"

STORAGE_TEST_PATH :: "build/core-test/storage.sqlite3"

// A database as the first releases wrote it: processes without a type,
// and an account without a sync token.
WriteOldDatabase :: () -> bool {
    path: [128]u8
    if !CopyCString(STORAGE_TEST_PATH, path[:]) {
        return false
    }
    old: *void = null
    flags: s32 = SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE
    if SqliteOpen(*path[0], *old, flags) != SQLITE_OK {
        return false
    }
    ok := SqliteExecText(old, "create table processes (id text primary key, topic text not null); insert into processes values ('p1', 'Lunch'); create table proposals (id integer primary key, process_id text not null, title text not null); insert into proposals values (1, 'p1', 'Soup'); create table account (id integer primary key check(id = 1), public_id text not null, public_key text not null, private_key text not null); insert into account values (1, 'me', 'pub', 'priv'); create table settings (key text primary key, value text not null); insert into settings values ('locale', 'de');") == SQLITE_OK
    unused SqliteClose(old)
    return ok
}

Count :: (sql: string) -> s32 {
    statement: *void = null
    if SqlitePrepareText(database, sql, -1, *statement, null) != SQLITE_OK {
        return -1
    }
    count: s32 = -1
    if SqliteStep(statement) == SQLITE_ROW {
        count = SqliteColumnInt(statement, 0)
    }
    unused SqliteFinalize(statement)
    return count
}

#program_export
main :: () -> s32 {
    if !WriteOldDatabase() {
        return 1
    }
    // An unsupported schema is refused without destroying old decisions.
    if StorageOpen(STORAGE_TEST_PATH) {
        return 2
    }
    name: [128]u8
    unused CopyCString(STORAGE_TEST_PATH, name[:])
    old: *void = null
    if SqliteOpen(*name[0], *old, SQLITE_OPEN_READWRITE) != SQLITE_OK {
        return 23
    }
    database = old
    if Count("select count(*) from processes where topic='Lunch'") != 1 || Count("select count(*) from proposals") != 1 {
        return 24
    }
    // Only this disposable fixture is reset, explicitly by the test.
    unused SqliteExecText(database, "drop table processes; drop table proposals")
    StorageClose()
    if !StorageOpen(STORAGE_TEST_PATH) {
        return 25
    }
    // Account and settings remain, with missing columns added.
    if !StorageTableHasColumn("processes", "type") || !StorageTableHasColumn("processes", "voting_access") {
        return 3
    }
    if Count("select count(*) from processes") != 0 || Count("select count(*) from proposals") != 0 {
        return 4
    }
    if Count("select count(*) from account where public_id = 'me' and public_key = 'pub' and private_key = 'priv'") != 1 {
        return 5
    }
    value: [32]u8
    if SettingLoadText("locale", "en", value[:]) != "de" || SettingLoadText("missing", "fallback", value[:]) != "fallback" {
        return 6
    }
    if !SettingSaveText("locale", "ja") || !SettingSaveInt("zoom", -120) {
        return 7
    }
    // Opening again keeps the data and adds nothing twice.
    StorageClose()
    if !StorageOpen(STORAGE_TEST_PATH) {
        return 8
    }
    if SettingLoadText("locale", "en", value[:]) != "ja" || SettingLoadInt("zoom", 0) != -120 || SettingLoadInt("missing", 7) != 7 {
        return 9
    }
    if StorageReadInt("+12x") != 12 || StorageReadInt("junk") != 0 || StorageReadInt("99999999999") != 2147483647 {
        return 10
    }
    if !SaveProcesses() {
        return 12
    }
    if StorageLoadProcesses() != 2 {
        return 13
    }
    // Newest first; a consent weight of 0 reads as Infinity.
    newest := process_rows[0]
    oldest := process_rows[1]
    if TextUntilNul(newest.id[:]) != "ranked-1" || newest.type != ProcessType.ProcessRanked || newest.created_at != 200 {
        return 14
    }
    if TextUntilNul(oldest.topic[:]) != "Café night" || oldest.negative_weight != NEGATIVE_WEIGHT_INFINITY || TextUntilNul(oldest.voting_access[:]) != "public" {
        return 15
    }
    // The consent process got the two standing proposals; the ranked one
    // kept its labelled option and skipped the blank one.
    if Count("select count(*) from proposals where process_id = 'consent-1' and author_user_id = 'owner' and synced = 1") != 2 {
        return 16
    }
    if Count("select count(*) from options where process_id = 'ranked-1'") != 1 {
        return 17
    }
    if !CheckDetail() {
        return 19
    }
    if !CheckLocalChanges() {
        return 20
    }
    if !CheckOwnerAndId() {
        return 22
    }
    // A duplicate id fails and leaves nothing half-saved.
    proposals := Count("select count(*) from proposals")
    if SaveConsent("consent-1", 300) || Count("select count(*) from processes") != 2 || Count("select count(*) from proposals") != proposals {
        return 18
    }
    StorageClose()
    if SettingSaveText("closed", "x") {
        return 11
    }
    return 0
}

Standing :: () -> StandingProposals {
    standing: StandingProposals
    standing.status_quo_title = "Status quo"
    standing.status_quo_description = "Keep things as they are."
    standing.repeat_title = "Repeat process"
    standing.repeat_description = "Decide again later."
    return standing
}

SaveConsent :: (id: string, created_at: s64) -> bool {
    ProcessClear()
    row: ProcessRow
    SetText(row.id[:], id)
    SetText(row.owner[:], "owner")
    SetText(row.topic[:], "Café night")
    SetText(row.visibility[:], "public")
    row.type = ProcessType.ProcessConsent
    row.negative_weight = 0
    row.created_at = created_at
    return StorageSaveNewProcess(row, "Owner", Standing())
}

SaveProcesses :: () -> bool {
    if !SaveConsent("consent-1", 100) {
        return false
    }
    ProcessClear()
    process.option_count = 2
    SetText(process.options[0].id[:], "o1")
    SetText(process.options[0].label[:], "Pizza")
    SetText(process.options[1].id[:], "o2")
    SetText(process.options[1].label[:], "   ")
    row: ProcessRow
    SetText(row.id[:], "ranked-1")
    SetText(row.owner[:], "owner")
    SetText(row.topic[:], "Dinner")
    row.type = ProcessType.ProcessRanked
    row.created_at = 200
    return StorageSaveNewProcess(row, "Owner", Standing())
}

// Stored ballots fill the score matrix, so leaving a voter out of the
// results recomputes from the ballots that remain.
CheckDetail :: () -> bool {
    if SqliteExecText(database, "insert into votes values ('consent-1', 'ann', 'Ann', '', 'status-quo=3;repeat-process=-1', 10, 0); insert into votes values ('consent-1', 'ben', 'Ben', '', 'status-quo=-2;gone=3', 20, 0);") != SQLITE_OK {
        return false
    }
    if !StorageLoadProcessDetail(process_rows[1], Standing()) {
        return false
    }
    if process.proposal_count != 2 || TextUntilNul(process.proposals[0].id[:]) != "status-quo" || TextUntilNul(process.proposals[1].title[:]) != "Repeat process" {
        return false
    }
    // Ann, Ben, and the owner who wrote the proposals.
    if process.participant_count != 3 || ProcessIncludedBallots() != 2 {
        return false
    }
    first := ProcessProposalTally(0)
    if first.positive_total != 3 || first.negative_total != -2000000 || first.vote_count != 2 {
        return false
    }
    ben := ProcessParticipantFind("ben")
    process.participants[ben].excluded = true
    first = ProcessProposalTally(0)
    return ProcessSubsetActive() && first.total == 3 && first.vote_count == 1 && TextUntilNul(process.participants[ben].updated_at[:]) == "20"
}

// Saving another participant's ballot never replaces an existing participant.
CheckLocalChanges :: () -> bool {
    rowid := StorageSaveLocalProposal("consent-1", "ann", "Ann", "Picnic", "", 30)
    if rowid <= 0 || StorageSaveLocalProposal("consent-1", "ann", "Ann", "   ", "", 31) != -1 {
        return false
    }
    local: [24]u8
    local_id := StorageLocalProposalId(rowid, local[:])
    ballot: [64]u8
    length := BallotAppend(ballot[:], 0, "status-quo", 1)
    length = BallotAppend(ballot[:], length, local_id, 3)
    if !StorageSaveLocalVote("consent-1", "ann", "Ann", TextUntilNul(ballot[:]), 40) {
        return false
    }
    return Count("select count(*) from votes where voter_user_id='ann'") == 1 && Count("select count(*) from votes where voter_user_id='ben'") == 1
}

// Process ownership follows the selected local identity; identifiers are unique.
CheckOwnerAndId :: () -> bool {
    owner: [96]u8
    account := StorageActiveParticipant("p-owner", true)
    if StorageParticipantId("p-owner", owner[:]) != TextUntilNul(account.keys.public_id[:]) {
        return false
    }
    id: [40]u8
    made := StorageNewProcessId(0x66f9a2b1, id[:])
    if made.count != 17 || made[8] != cast(u8)45 || made[0:8] != "66f9a2b1" {
        return false
    }
    other: [40]u8
    return StorageNewProcessId(0x66f9a2b1, other[:]) != made
}

// Names cannot take over a ballot; guest identities survive a database reopen.
CheckGuestIdentity :: () -> bool {
    guest := StorageActiveParticipant("guest-test", true)
    if !guest.loaded {
        return false
    }
    StorageClose()
    if !StorageOpen(STORAGE_TEST_PATH) {
        return false
    }
    restored := StorageActiveParticipant("guest-test", false)
    if !restored.loaded || !AccountValuesEqual(*guest.keys, *restored.keys) {
        return false
    }
    next := StorageNewParticipant("guest-test")
    if !next.loaded || AccountValuesEqual(*guest.keys, *next.keys) {
        return false
    }
    if !StorageSelectParticipant("guest-test", TextUntilNul(guest.keys.public_id[:])) {
        return false
    }
    selected := StorageActiveParticipant("guest-test", false)
    if !selected.loaded || !AccountValuesEqual(*guest.keys, *selected.keys) {
        return false
    }
    if !StorageSaveLocalVote("consent-1", "key-alice", "Alice", "status-quo=3", 50) {
        return false
    }
    if StorageSaveLocalVote("consent-1", "key-mallory", " alice ", "status-quo=-3", 51) {
        return false
    }
    if StorageSaveLocalVote("consent-1", "key-mallory", "Mallory", "", 51) {
        return false
    }
    return StorageSaveLocalVote("consent-1", "key-alice", "Alice", "status-quo=2", 52) && Count("select count(*) from votes where voter_user_id='key-alice' and scores='status-quo=2'") == 1
}
